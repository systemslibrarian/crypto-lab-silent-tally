{
  "name": "silent-tally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "wasm-pack build --target web --out-dir pkg",
    "test": "vitest run && node --test tests/publish-request.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test tests/publish-request.test.mjs",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-silent-tally --ref main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
